{
  "name": "ownbase",
  "productName": "Ownbase",
  "version": "0.1.0",
  "private": true,
  "description": "Native Windows Server Hub - Standalone server orchestration without Docker or WSL2",
  "author": "rhmunna143",
  "main": "dist/electron/index.js",
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:daemon\" \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev -p 3000",
    "dev:all": "concurrently -k \"npm run dev:daemon\" \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:3001 http://127.0.0.1:3000 && tsc -p tsconfig.electron.json && electron . --dev",
    "dev:daemon": "tsx watch src/daemon/main.ts",
    "build": "npm run build:next && npm run build:electron",
    "build:next": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:daemon": "tsc -p tsconfig.electron.json",
    "start": "tsc -p tsconfig.electron.json && electron .",
    "start:daemon": "node dist/daemon/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:phase2": "vitest run tests/phase2",
    "test:phase3": "vitest run tests/phase3",
    "test:phase4": "vitest run tests/phase4",
    "test:phase5": "vitest run tests/phase5",
    "test:phase6": "vitest run tests/phase6",
    "test:phase7": "vitest run tests/phase7",
    "test:phase8": "vitest run tests/phase8",
    "compile:jobhost": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /out:extraResources\\bin\\ownbase-jobhost.exe /target:exe tools\\jobhost\\Program.cs",
    "compile:ollama": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /out:extraResources\\bin\\ollama.exe /target:exe tools\\mocks\\ollama_server.cs",
    "dist:dir": "npm run build && electron-builder --dir",
    "build:installer": "npm run build && electron-builder --win nsis:x64 && node scripts/finalize-release.js",
    "build:portable": "npm run build && electron-builder --win portable:x64 && node scripts/finalize-release.js",
    "build:all": "npm run build && electron-builder --win nsis:x64 portable:x64 && node scripts/finalize-release.js",
    "dist:win": "npm run build:installer",
    "dist:portable": "npm run build:portable",
    "dist:all": "npm run build:all",
    "package": "npm run build:installer"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "jose": "^6.2.12",
    "koffi": "^3.3.3",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "prisma": "^6.4.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12",
    "wait-on": "^8.0.1"
  }
}
