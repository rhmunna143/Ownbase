{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.rhmunna143.ownbase",
  "productName": "Ownbase",
  "copyright": "Copyright © 2026 rhmunna143",
  "directories": {
    "output": "release-build",
    "buildResources": "assets"
  },
  "files": [
    "dist/electron/**/*",
    "dist/daemon/**/*",
    "dist/shared/**/*",
    "dist/main/**/*",
    "dist/preload/**/*",
    "out/**/*",
    "package.json",
    "assets/**/*",
    "prisma/**/*",
    "node_modules/.prisma/**/*",
    "node_modules/@node-rs/**/*"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "asar": true,
  "asarUnpack": [
    "dist/daemon/**/*",
    "dist/shared/**/*",
    "node_modules/@prisma/**/*",
    "node_modules/prisma/**/*",
    "node_modules/.prisma/**/*",
    "node_modules/@node-rs/**/*",
    "node_modules/argon2/**/*",
    "node_modules/koffi/**/*",
    "node_modules/node-pty/**/*",
    "out/**/*"
  ],
  "afterPack": "./scripts/after-pack.js",
  "extraResources": [
    {
      "from": "out",
      "to": "out",
      "filter": ["**/*"]
    },
    {
      "from": "extraResources/bin",
      "to": "extraResources/bin",
      "filter": ["**/*"]
    },
    {
      "from": "extraResources/pgsql",
      "to": "extraResources/pgsql",
      "filter": ["bin/**/*", "lib/**/*", "share/**/*"]
    },
    {
      "from": "assets",
      "to": "assets",
      "filter": ["**/*"]
    },
    {
      "from": "prisma",
      "to": "prisma",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/.prisma",
      "to": "node_modules/.prisma",
      "filter": ["**/*"]
    },
    {
      "from": "installer",
      "to": "installer",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "sign": "./scripts/custom-sign.js"
  },
  "nsis": {
    "include": "installer/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Ownbase",
    "uninstallDisplayName": "Ownbase",
    "deleteAppDataOnUninstall": false,
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}",
    "requestExecutionLevel": "user",
    "unpackDirName": false
  }
}
