model AlertRule {
  id              String        @id @default(uuid())
  name            String
  metric          String        // "service_status" | "disk_usage" | "cert_expiry" | "backup_status"
  condition       String        // "equals" | "greater_than" | "less_than"
  threshold       String        // "failed", "90", "14"
  severity        String        @default("warning") // "info" | "warning" | "critical"
  isEnabled       Boolean       @default(true)
  webhookUrl      String?
  lastTriggeredAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  alerts          SystemAlert[]

  @@map("alert_rules")
}

model SystemAlert {
  id         String     @id @default(uuid())
  ruleId     String?
  title      String
  message    String
  severity   String     // "info" | "warning" | "critical"
  resolved   Boolean    @default(false)
  resolvedAt DateTime?
  metadata   Json?
  createdAt  DateTime   @default(now())
  rule       AlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@map("system_alerts")
}
