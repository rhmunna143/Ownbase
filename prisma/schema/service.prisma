model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   // caddy, filebrowser, ollama, postgres, custom
  executable  String
  port        Int?
  status      String   @default("stopped") // stopped, running, error, restarting
  autoStart   Boolean  @default(true)
  pid         Int?
  description String?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  routes      Route[]

  @@map("services")
}
